{
  "name": "recipe-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "tsc -b --pretty false",
    "test": "npm run test:node && npm run test:worker",
    "test:node": "vitest run",
    "test:worker": "vitest run --config vitest.worker.config.ts",
    "test:watch": "vitest",
    "worker:types": "wrangler types worker/env.d.ts --strict-vars=false --include-runtime=false",
    "worker:dev": "wrangler dev worker/index.ts",
    "worker:deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
    "dexie": "^4.0.8",
    "heic-to": "^1.5.2",
    "jose": "^6.0.10",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router": "^8.3.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^5.20260810.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.1",
    "fake-indexeddb": "^6.2.5",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-pwa": "^0.21.1",
    "vitest": "^4.1.10",
    "wrangler": "^4.120.0"
  }
}
